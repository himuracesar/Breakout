{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Launch (CMake)",
            "type": "cppvsdbg", // Usa "cppdbg" si estás con MinGW, o "cppvsdbg" si estás con MSVC
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build", // <-- ¡IMPORTANTE! Esto pone la carpeta de trabajo dentro de build
            "environment": [],
            "console": "externalTerminal"
        }
    ]
}